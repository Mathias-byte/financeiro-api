{
  "name": "ms-financeiro",
  "version": "1.0.0",
  "description": "Microsserviço Financeiro (condominio_financeiro) — PropTech, PI5 Senac RJ",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "npx infisical run --env=dev -- ts-node-dev --respawn src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@nestjs/passport": "^11.0.5",
    "@prisma/adapter-mariadb": "7.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "7.10.0",
    "typescript": "5.9",
    "@infisical/cli": "0.44.3",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0"
  },
  "jest": {
    "rootDir": ".",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": "(src|test)/.*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ]
  }
}
