# Este arquivo é só um MODELO. Copie para .env (que não vai para o Git) ou, melhor, use o Infisical:
#   npm run start:dev          (usa o Infisical)
# As variáveis abaixo existem no Infisical (ambiente "dev"); não escreva senhas reais aqui.

# MySQL 5.7 do servidor da faculdade (usuário, senha e banco vêm do Infisical)
# Formato: mysql://USUARIO:SENHA@edumysql.acesso.rj.senac.br:3306/NOME_DO_BANCO_FINANCEIRO
# Atenção: no servidor Linux o nome do banco diferencia maiúsculas de minúsculas. Copie exatamente o que o professor criou.
DATABASE_URL="mysql://usuario:senha@edumysql.acesso.rj.senac.br:3306/20262M_prj5_condominio_financeiro"

# Porta do microsserviço (rotas sob /condominio/financeiro)
PORT=7523

# JWT — TEM de ser exatamente o mesmo valor do MS Moradores (que emite o token); aqui só validamos
JWT_SECRET="o-mesmo-segredo-do-ms-moradores"

# Swagger (documentação interativa em /condominio/financeiro/docs). Em produção (imagem Docker) fica DESLIGADO.
# true = liga em qualquer ambiente (ex.: demonstração) | false = desliga | vazio = liga só fora de produção
SWAGGER_ENABLED=
